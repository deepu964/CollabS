# Cloudinary Configuration
# Sign up at https://cloudinary.com/ (free tier)
# 1. Get your "Cloud Name" from Cloudinary Dashboard
# 2. Go to Settings > Upload > Add upload preset > set "Signing Mode" to "Unsigned" > Save
VITE_CLOUDINARY_CLOUD_NAME=dtaz4vhxh
VITE_CLOUDINARY_UPLOAD_PRESET=ml_default

# Firebase Configuration
# Sign up at https://firebase.google.com/ (free Spark plan)
# 1. Create a Firebase project
# 2. Add a Web App to get these config keys
# 3. Enable Cloud Firestore in "Test mode" (or create rules for read/write)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
