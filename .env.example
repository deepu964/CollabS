# Cloudinary Configuration
# 1. Cloud Name: Found on your Cloudinary Dashboard
# 2. Upload Preset: Settings > Upload > Upload presets > set "Signing Mode" to "Unsigned"
# 3. For public cross-browser sync: Settings > Security > Enable 'Resource list'
VITE_CLOUDINARY_CLOUD_NAME=dtaz4vhxh
VITE_CLOUDINARY_UPLOAD_PRESET=CollabS

# Team Member Role Security PINs (Method 1)
# 4-Digit access codes for each authorized team pillar
VITE_PIN_ADMIN=1001
VITE_PIN_BACKEND=2002
VITE_PIN_B2B=3003
VITE_PIN_DRIVER=4004
VITE_PIN_QA=5005

# Email Mention Notifications (EmailJS - Free tier: 200 emails/month)
# 1. Sign up on https://www.emailjs.com/
# 2. Add an Email Service (e.g. Gmail) -> Copy Service ID
# 3. Create an Email Template -> Copy Template ID
#    Template variables: {{to_name}}, {{to_email}}, {{sender_name}}, {{channel_name}}, {{notification_message}}, {{app_url}}
# 4. Account Settings -> Copy Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=co_eqiKm8dgISuMaT


# Default Alert Emails for Team Roles (Can also be set in-app from user profile)
VITE_EMAIL_ADMIN=admin@example.com
VITE_EMAIL_BACKEND=developer@example.com
VITE_EMAIL_B2B=b2b@example.com
VITE_EMAIL_DRIVER=driver@example.com
VITE_EMAIL_QA=qa@example.com
