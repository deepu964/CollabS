# Cloudinary Configuration
# 1. Cloud Name: Found on your Cloudinary Dashboard
# 2. Upload Preset: Settings > Upload > Upload presets > set "Signing Mode" to "Unsigned"
# 3. For public cross-browser sync: Settings > Security > Enable 'Resource list'
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Server & JWT Authentication Secrets
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Team Member Role Security PINs
VITE_PIN_ADMIN=1001
VITE_PIN_BACKEND=2002
VITE_PIN_B2B=3003
VITE_PIN_DRIVER=4004
VITE_PIN_QA=5005
